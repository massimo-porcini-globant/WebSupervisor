{
  "name": "websupervisor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "build": "npm run build -w @ws/client",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w @ws/shared && npm run typecheck -w @ws/server && npm run typecheck -w @ws/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "concurrently -n client,server -c blue,green \"npm run dev -w @ws/client\" \"npm run dev -w @ws/server\"",
    "seed": "npm run seed -w @ws/server"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {}
}